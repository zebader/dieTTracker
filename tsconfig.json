{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest"],
    "strict": true,
    "paths": {
      "*": ["./*"],
      "@/*": [
        "./src/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/providers/*": [
        "./src/providers/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/assets": [
        "./assets/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
